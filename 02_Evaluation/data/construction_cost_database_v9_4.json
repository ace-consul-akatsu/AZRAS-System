  "rc_foundation_unit_price_basis_patch049": {
    "status": "public_methodology_plus_user_confirmed_current_rate",
    "public_sources": [
      {
        "source": "MLIT Public Building Works Standard Unit Price Estimation Standard, 2026 revision",
        "url": "https://www.mlit.go.jp/gobuild/content/001733130.pdf",
        "supported_points_ja": [
          "土工の数量は地山数量を基本とする。",
          "根切りは積込みまでを含む。",
          "購入土を用いる場合は材料所要量20%割増を標準とする。"
        ]
      },
      {
        "source": "MLIT Public Building Works Standard Unit Price Estimation Standard, 2026 revision (mechanical section table M1-1-70)",
        "url": "https://www.mlit.go.jp/gobuild/content/001733132.pdf",
        "supported_points_ja": [
          "根切り・埋戻し・砂利地業の標準歩掛が公開されている。",
          "0.28m3バックホウ根切り: バックホウ0.025日/m3 + 普通作業員0.03人/m3。",
          "0.28m3バックホウ埋戻し: バックホウ0.020日/m3 + タンパ0.031日/m3 + 普通作業員0.07人/m3。",
          "砂利地業: 砂利1.1m3/m3 + 普通作業員0.2人/m3。"
        ]
      },
      {
        "source": "Aichi Prefecture Building Cost Estimation / Unit Price page, 2026",
        "url": "https://www.pref.aichi.jp/soshiki/kensetsu-kikaku/kenchikusekisan.html",
        "supported_points_ja": [
          "鋼材・生コン等の主要資材単価は毎月改定。",
          "市場単価・標準材料単価は原則年4回改定。",
          "物価資料掲載単価は非公表。"
        ]
      }
    ],
    "rate_policy_ja": {
      "excavation": "公開歩掛は採用可能。ただし2026愛知県の労務・機械日額を公開資料だけでは確定できないため、完成単価はユーザー確認値を入力。",
